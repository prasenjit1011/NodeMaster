# Local development only (never commit real values).
# For AWS deploy, set the same values as GitHub Actions secrets instead.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/demat?retryWrites=true&w=majority
PORT=3000

# GitHub Actions secrets (repo → Settings → Secrets and variables → Actions):
#   AWS_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY
#   AWS_REGION
#   MONGODB_URI          → becomes Lambda process.env.MONGODB_URI_TICKERTAPE
#   TF_STATE_BUCKET
# Optional:
#   TF_STATE_KEY
#   PROJECT_NAME
#   ENVIRONMENT
