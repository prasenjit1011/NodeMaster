@baseUrl = http://localhost:3000
@categoryId = 1755940000000

### Health / Welcome
GET {{baseUrl}}/


### =========================================================
### CATEGORIES
### =========================================================

### Get all categories
GET {{baseUrl}}/categories


### Get categories updated after timestamp
GET {{baseUrl}}/categories?since=0


### Get category by ID
GET {{baseUrl}}/categories/{{categoryId}}


### Create category
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "title": "Electronics",
  "shortDetails": "Electronic products",
  "longDetails": "All types of electronic products",
  "status": true,
  "orderBy": 1,
  "thumbUrl": "",
  "bannerUrl": "",
  "imageUrls": [],
  "types": [
    {
      "id": 1,
      "title": "Mobile",
      "status": true,
      "orderBy": 1
    },
    {
      "id": 2,
      "title": "Laptop",
      "status": true,
      "orderBy": 2
    }
  ]
}


### Create category with custom ID
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "id": "electronics",
  "title": "Electronics",
  "shortDetails": "Electronic products",
  "longDetails": "All types of electronic products",
  "status": true,
  "orderBy": 1,
  "types": []
}


### Update / Upsert category
PUT {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json

{
  "title": "Electronics Updated",
  "shortDetails": "Updated electronic products",
  "longDetails": "Updated details",
  "status": true,
  "orderBy": 2,
  "thumbUrl": "https://example.com/thumb.jpg",
  "bannerUrl": "https://example.com/banner.jpg",
  "imageUrls": [
    "https://example.com/image1.jpg",
    "https://example.com/image2.jpg"
  ],
  "types": [
    {
      "id": 1,
      "title": "Mobile",
      "status": true,
      "orderBy": 1
    },
    {
      "id": 2,
      "title": "Laptop",
      "status": true,
      "orderBy": 2
    }
  ]
}


### Soft delete category
DELETE {{baseUrl}}/categories/{{categoryId}}


### Upload image through API (binary body)
POST {{baseUrl}}/uploads?categoryId={{categoryId}}&kind=thumb&imageId=thumb
Content-Type: image/jpeg

< ./sample-thumb.jpg

### =========================================================
### S3 IMAGE UPLOAD
### =========================================================

### Get presigned URL for thumbnail
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "kind": "thumb",
  "contentType": "image/jpeg"
}


### Get presigned URL for banner
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "kind": "banner",
  "contentType": "image/jpeg"
}


### Get presigned URL for gallery image
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "kind": "gallery",
  "imageId": "1",
  "contentType": "image/jpeg"
}


### Gallery image - PNG example
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "kind": "gallery",
  "imageId": "2",
  "contentType": "image/png"
}


### =========================================================
### DATA
### =========================================================

### Get all data
GET {{baseUrl}}/data


### Get data by ID
GET {{baseUrl}}/data/123